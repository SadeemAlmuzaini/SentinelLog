# SentinelLog - environment variables (example)
# Copy this file to ".env" and fill in real values if you want to enable the
# OPTIONAL Gemini integration. The application is fully functional without
# this file or any API key — the core report is generated locally.

# Optional: enables a future/optional AI-enhanced report pass.
# Leave empty or unset to keep the app fully offline.
GEMINI_API_KEY=

# Optional: change the local port the backend listens on (default 5000).
# On Render this is set automatically -- do not hardcode it there.
PORT=5000

# Optional: signs session cookies that keep each visitor's analysis result
# separate from every other visitor's on a shared/public deployment. If
# unset, a random key is generated at process startup (sessions simply
# reset on restart). Set a fixed value for a production deployment so a
# restart does not invalidate everyone's current session.
SECRET_KEY=
